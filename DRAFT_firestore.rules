rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isVerified() { return request.auth.token.email_verified == true; }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'wilaya', 'subscription', 'approved'])
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 5 && data.email.size() <= 100
        && data.role in ['user', 'worker', 'shop', 'admin']
        && data.wilaya is string && data.wilaya.size() > 0
        && data.subscription in ['none', 'yearly', 'lifetime']
        && data.approved is bool;
    }

    function isValidShop(data) {
      return data.keys().hasAll(['name', 'ownerId', 'wilaya'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ownerId == request.auth.uid
        && data.wilaya is string;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'type', 'proofImageUrl', 'status', 'createdAt'])
        && data.userId == request.auth.uid
        && data.type in ['yearly', 'lifetime']
        && data.proofImageUrl is string && data.proofImageUrl.size() > 10
        && data.status == 'pending'
        && data.createdAt == request.time;
    }

    // --- Collection Matches ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() 
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().role != 'admin' // Cannot register as admin
        && incoming().approved == false
        && incoming().subscription == 'none';
      
      allow update: if (
        (isOwner(userId) && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'wilaya']))
        || 
        (isAdmin() && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasAny(['role', 'approved', 'subscription']))
      );
    }

    match /shops/{shopId} {
      allow read: if true; // Public directory
      allow create: if isSignedIn() && isValidId(shopId) && isValidShop(incoming());
      allow update: if (isOwner(existing().ownerId) && isValidShop(incoming())) || isAdmin();
      allow delete: if isAdmin();

      match /products/{productId} {
        allow read: if true;
        allow write: if (isSignedIn() && isOwner(get(/databases/$(database)/documents/shops/$(shopId)).data.ownerId)) || isAdmin();
      }
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid 
        || resource.data.workerId == request.auth.uid 
        || isOwner(get(/databases/$(database)/documents/shops/$(resource.data.shopId)).data.ownerId)
        || isAdmin()
      );
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status'])) // user can cancel maybe?
        || (incoming().workerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['workerId', 'status', 'deliveryTime']))
        || isAdmin()
      );
    }

    match /payments/{paymentId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming());
      allow update: if isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
    }
  }
}
